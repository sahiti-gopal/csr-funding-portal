[Unit]
Description=CSR Funding Portal API (gunicorn)
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/csr-funding-portal/backend
EnvironmentFile=/home/ubuntu/csr-funding-portal/backend/.env
ExecStart=/home/ubuntu/csr-funding-portal/backend/.venv/bin/gunicorn --preload run:app --bind 127.0.0.1:8000 --workers 3
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
