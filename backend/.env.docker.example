# Template for backend/.env when running via docker-compose.prod.yml.
# DB_HOST/DB_PORT point at the "mysql" service on the compose network, not
# localhost:3307 like the local-dev .env.example does.

FLASK_APP=run.py
FLASK_ENV=production

SECRET_KEY=your-secret-key

DB_HOST=mysql
DB_PORT=3306
DB_NAME=csr_funding_portal
DB_USER=csr_user
DB_PASSWORD=your-password

GEMINI_API_KEY=your-gemini-api-key

ALLOWED_ORIGINS=https://yourdomain.com

# Demo admin account created by seed_users.py
SEED_ADMIN_EMAIL=admin@sevaimpact.org
SEED_ADMIN_PASSWORD=your-password

# If the database is empty on startup, run.py auto-seeds it (seed.py + seed_users.py)
# before the app starts serving. Set to false to disable and seed manually instead.
AUTO_SEED=true
