FLASK_APP=run.py
FLASK_ENV=development

SECRET_KEY=your-secret-key

DB_HOST=localhost
DB_PORT=3307
DB_NAME=csr_funding_portal
DB_USER=csr_user
DB_PASSWORD=your-password

GEMINI_API_KEY=your-gemini-api-key

# Comma-separated list of origins allowed to call the API.
# Dev default is the Vite dev server; add the deployed frontend URL in production.
ALLOWED_ORIGINS=http://localhost:5173

# Demo admin account created by seed.py
SEED_ADMIN_EMAIL=admin@sevaimpact.org
SEED_ADMIN_PASSWORD=Admin@123

# If the database is empty on startup, run.py auto-seeds it (seed.py)
# before the app starts serving. Set to false to disable and seed manually instead.
AUTO_SEED=true