FLASK_APP=run.py
FLASK_ENV=development

SECRET_KEY=your-secret-key

DB_HOST=localhost
DB_PORT=3307
DB_NAME=csr_funding_portal
DB_USER=csr_user
DB_PASSWORD=your-password

GEMINI_API_KEY=your-gemini-api-key

# Comma-separated list of origins allowed to call the API.
# Dev default is the Vite dev server; add the deployed frontend URL in production.
ALLOWED_ORIGINS=http://localhost:5173

# Credentials for the standalone dev login server (backend/api/login_api.py)
LOGIN_API_EMAIL=your-email@example.com
LOGIN_API_PASSWORD=your-password